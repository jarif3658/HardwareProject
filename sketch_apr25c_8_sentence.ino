// MP3 command function
void sendMP3Command(byte command, byte param1, byte param2) {
  byte buf[10] = {0x7E, 0xFF, 0x06, command, 0x00, param1, param2, 0xEF};
  for (int i = 0; i < 8; i++) {
    mp3Serial.write(buf[i]);
  }
}

// Display English + Bangla function
void showMessage(const char* englishText, const uint8_t* banglaBmp, int bmpW, int bmpH) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);

  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(englishText, 0, 0, &x1, &y1, &w, &h);

  int enX = (SCREEN_WIDTH - w) / 2;
  display.setCursor(enX, 0);
  display.print(englishText);

  int bmpX = (SCREEN_WIDTH - bmpW) / 2;
  int bmpY = 22;
  display.drawBitmap(bmpX, bmpY, banglaBmp, bmpW, bmpH, SH110X_WHITE);

  display.display();
}

// Display English only
void showEnglishOnly(const char* text) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);

  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);

  int textX = (SCREEN_WIDTH - w) / 2;
  display.setCursor(textX, 20);
  display.print(text);
  display.display();
}

// Display phone messages
void showPhoneMessage(const String &msg) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);

  display.setCursor(0, 0);
  display.print("Phone:");

  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(msg.c_str(), 0, 0, &x1, &y1, &w, &h);

  int msgX = (SCREEN_WIDTH - w) / 2;
  display.setCursor(msgX, 20);
  display.print(msg);
  display.display();
}

void setup() {
  Serial.begin(9600);     // Bluetooth on D0/D1
  mp3Serial.begin(9600);  // DFPlayer on D10/D11

  Wire.begin();
  if (!display.begin(0x3C, true)) {
    while (1);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  display.setCursor(20, 25);
  display.print("System Ready");
  display.display();
  delay(1000);
}

void loop() {
  // --- Check Bluetooth first ---
  if (BT.available()) {
    String msg = "";
    while (BT.available()) {
      char c = BT.read();
      if (c != '\n' && c != '\r') {
        msg += c;
      }
    }

    if (msg.length() > 0) {
      showPhoneMessage(msg);
      delay(2000);
    }
  }

  // --- Read flex sensors ---
  int v1 = analogRead(flexPin1);
  int v2 = analogRead(flexPin2);
  int v3 = analogRead(flexPin3);
  int v4 = analogRead(flexPin4);
  int v5 = analogRead(flexPin5);

  bool f1 = (v1 > TH1);
  bool f2 = (v2 > TH2);
  bool f3 = (v3 > TH3);
  bool f4 = (v4 > TH4);
  bool f5 = (v5 > TH5);

  // --- COMBINATION checks first ---
  if (f1 && f2) {
    showMessage("I am fine", fineBitmap, BMP_W, BMP_H);
    BT.println("I am fine");
    sendMP3Command(0x03, 0x00, 7);
    delay(1000);
  }
  else if (f1 && f3) {
    showMessage("I am happy", happyBitmap, BMP_W, BMP_H);
    BT.println("I am happy");
    sendMP3Command(0x03, 0x00, 6);
    delay(1000);
  }
  else if (f1 && f4) {   // A1 + A6
    showMessage("I am not feeling well", notWellBitmap, BMP_W, BMP_H);
    BT.println("I am not feeling well");
    sendMP3Command(0x03, 0x00, 8);
    delay(1000);
  }

  // --- Single sensor checks ---
  else if (f1) {
    showMessage("I need water", waterBitmap, BMP_W, BMP_H);
    BT.println("I need water");
    sendMP3Command(0x03, 0x00, 1);
    delay(1000);
  }
  else if (f2) {
    showMessage("Thank you", thankYouBitmap, BMP_W, BMP_H);
    BT.println("Thank you");
    sendMP3Command(0x03, 0x00, 2);
    delay(1000);
  }
  else if (f3) {
    showMessage("Hello", helloBitmap, BMP_W, BMP_H);
    BT.println("Hello");
    sendMP3Command(0x03, 0x00, 4);
    delay(1000);
  }
  else if (f4) {
    showMessage("I need food", foodBitmap, BMP_W, BMP_H);
    BT.println("I need food");
    sendMP3Command(0x03, 0x00, 5);
    delay(1000);
  }
  else if (f5) {
    showMessage("Please help me", helpBitmap, BMP_W, BMP_H);
    BT.println("Please help me");
    sendMP3Command(0x03, 0x00, 3);
    delay(1000);
  }

  delay(300);
}
